CC = gcc
CFLAGS = -pthread

all: peer1/peer peer2/peer peer3/peer

# Create the directories first, then compile into each
peer1/peer: peer.c
	mkdir -p peer1
	$(CC) $(CFLAGS) -o peer1/peer peer.c

peer2/peer: peer.c
	mkdir -p peer2
	$(CC) $(CFLAGS) -o peer2/peer peer.c

peer3/peer: peer.c
	mkdir -p peer3
	$(CC) $(CFLAGS) -o peer3/peer peer.c

clean:
	rm -f peer1/peer peer2/peer peer3/peer